# Local dev (kind) Keycloak. Loaded by Vite only in `vite dev` (mode=development); production builds
# get VITE_* from CI env instead. Points the SPA at the Traefik ingress host (auth.localhost), which is
# what the deployed Keycloak CR uses as its fixed hostname and what tokens carry as `iss` — so it must
# NOT be http://localhost:8180 (the operator-managed Keycloak only serves https://auth.localhost).
# NOTE: auth.localhost serves a self-signed dev cert — trust it once or the login iframe/redirect is
# blocked by the browser (see frontend README / platform/keycloak/README.md).
VITE_KEYCLOAK_URL=https://auth.localhost
VITE_KEYCLOAK_REALM=eurotransit
VITE_KEYCLOAK_CLIENT_ID=eurotransit-frontend